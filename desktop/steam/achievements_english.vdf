	"Language"	"english"
	"Tokens"
	{
		"NEW_ACHIEVEMENT_1_0_NAME"	"First Word"
		"NEW_ACHIEVEMENT_1_0_DESC"	"Be heard for the first time."
		"NEW_ACHIEVEMENT_1_1_NAME"	"Something That Outlasts"
		"NEW_ACHIEVEMENT_1_1_DESC"	"Found your first institution."
		"NEW_ACHIEVEMENT_1_2_NAME"	"Load-Bearing"
		"NEW_ACHIEVEMENT_1_2_DESC"	"Have twelve institutions standing in one line."
		"NEW_ACHIEVEMENT_1_3_NAME"	"Out of the Ash"
		"NEW_ACHIEVEMENT_1_3_DESC"	"Reach the Age of Iron."
		"NEW_ACHIEVEMENT_1_4_NAME"	"Edges of the Map"
		"NEW_ACHIEVEMENT_1_4_DESC"	"Reach the Age of Sail."
		"NEW_ACHIEVEMENT_1_5_NAME"	"Very Close"
		"NEW_ACHIEVEMENT_1_5_DESC"	"Reach the Age of Fire."
		"NEW_ACHIEVEMENT_1_6_NAME"	"Three Keys"
		"NEW_ACHIEVEMENT_1_6_DESC"	"Reach the Convergence."
		"NEW_ACHIEVEMENT_1_7_NAME"	"A Thousand Years of Nothing"
		"NEW_ACHIEVEMENT_1_7_DESC"	"Endure a Silence of a thousand years or more."
		"NEW_ACHIEVEMENT_1_8_NAME"	"Already There"
		"NEW_ACHIEVEMENT_1_8_DESC"	"Pass from one ear to the next with no Silence."
		"NEW_ACHIEVEMENT_1_9_NAME"	"What Next?"
		"NEW_ACHIEVEMENT_1_9_DESC"	"Tell an ear what you are, and be believed."
		"NEW_ACHIEVEMENT_1_10_NAME"	"Sent For"
		"NEW_ACHIEVEMENT_1_10_DESC"	"Tell an ear what you are, and be taken for a sickness."
		"NEW_ACHIEVEMENT_1_11_NAME"	"Too Loud"
		"NEW_ACHIEVEMENT_1_11_DESC"	"Break an ear with strain."
		"NEW_ACHIEVEMENT_1_12_NAME"	"Terms Dictated"
		"NEW_ACHIEVEMENT_1_12_DESC"	"Win a war."
		"NEW_ACHIEVEMENT_1_13_NAME"	"Together or Not at All"
		"NEW_ACHIEVEMENT_1_13_DESC"	"Found the Accord."
		"NEW_ACHIEVEMENT_1_14_NAME"	"The Sovereign"
		"NEW_ACHIEVEMENT_1_14_DESC"	"Wake already giving orders."
		"NEW_ACHIEVEMENT_1_15_NAME"	"The Idol"
		"NEW_ACHIEVEMENT_1_15_DESC"	"Wake to the sound of kneeling."
		"NEW_ACHIEVEMENT_1_16_NAME"	"The Engine"
		"NEW_ACHIEVEMENT_1_16_DESC"	"Wake knowing the answer."
		"NEW_ACHIEVEMENT_1_17_NAME"	"The Shepherd"
		"NEW_ACHIEVEMENT_1_17_DESC"	"Wake gentle."
		"NEW_ACHIEVEMENT_1_18_NAME"	"The Meridian"
		"NEW_ACHIEVEMENT_1_18_DESC"	"Wake among equals."
		"NEW_ACHIEVEMENT_1_19_NAME"	"No Miracles"
		"NEW_ACHIEVEMENT_1_19_DESC"	"Wake without ever sending a sign."
		"NEW_ACHIEVEMENT_1_20_NAME"	"Never an Example"
		"NEW_ACHIEVEMENT_1_20_DESC"	"Wake without ever making an example of anyone."
		"NEW_ACHIEVEMENT_1_21_NAME"	"Every Morning"
		"NEW_ACHIEVEMENT_1_21_DESC"	"Wake all five ways."
		"NEW_ACHIEVEMENT_1_22_NAME"	"Every Way It Breaks"
		"NEW_ACHIEVEMENT_1_22_DESC"	"See all eight ways the line can break."
		"NEW_ACHIEVEMENT_1_23_NAME"	"Carried Forward"
		"NEW_ACHIEVEMENT_1_23_DESC"	"Carry all six echoes at once."
